{
  "name": "hello-pear",
  "version": "1.0.0",
  "description": "Minimal hello-pear-bare-shaped project, for exercising the build pipeline.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://kv8bmfbpc9dcxhqmrp8xrxzbjfawcqrpwwx8kwqxeu9dxpcgnwno",
  "scripts": {
    "start": "bare bin.mjs",
    "test": "bare test/index.js",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name hello-pear --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name hello-pear --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name hello-pear --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name hello-pear --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name hello-pear --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name hello-pear --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "paparam": "^1.13.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.4"
  },
  "author": "Holepunch",
  "license": "Apache-2.0"
}
