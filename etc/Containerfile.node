# Node toolchain image, layered ON TOP of the base.
#
# The agent and the isolation posture live in the base, so every toolchain image inherits exactly
# the same sandbox behaviour -- a toolchain cannot accidentally weaken it, and there is one place to
# audit. This is what `toolchain:` in a workflow selects.
ARG BASE=localhost/bare-workflow-base:dev
FROM ${BASE}

# Node 22 from NodeSource, NOT Ubuntu's `nodejs` package, which is 18.19.1 on 24.04.
#
# Node 18 is not merely old here, it silently breaks one target. `bare-addon-resolve` calls
# `Array.prototype.with()` -- ES2023, so Node 20+ -- and it does so only on the branch guarded by
# `supportsUniversalPrebuilds(host)`, which is true for darwin and nothing else. On Node 18 that is
# a `TypeError: conditions.with is not a function` for `--host darwin-x64` while every linux and
# win32 target builds cleanly. A toolchain that can build five of six targets and fails the sixth
# with a type error from inside a dependency is exactly the kind of thing to pin deliberately.
ARG NODE_MAJOR=22
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get purge -y curl gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Fail the BUILD rather than a workflow six targets in. `Array.prototype.with` is the specific
# feature bare-build needs, so test for the capability, not the version string.
RUN node -e "if (typeof Array.prototype.with !== 'function') { console.error('node ' + process.version + ' lacks Array.prototype.with (ES2023); bare-build needs it for darwin hosts'); process.exit(1) }" \
 && echo "node $(node -v), npm $(npm -v)"
